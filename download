rules_version = '2';

// SMART PAPS Firestore 보안 규칙
//
// 이 프로그램은 Firebase 로그인(Auth)을 쓰지 않고 "학교 코드 + 접근 신청 비밀번호"라는
// 자체 방식으로 접근을 통제한다. 그래서 이 규칙은 Firebase Auth 기반의 세밀한 사용자별
// 권한 검사를 하지 못한다 — 대신 아래 두 가지 최소한의 안전장치만 건다.
//
//  1) 이 프로그램이 실제로 쓰는 키 이름(모두 "paps:"로 시작)만 읽고 쓸 수 있다. 그 밖의
//     임의의 문서 이름은 이 프로젝트를 통해 저장할 수 없다 — 즉, 이 Firestore 프로젝트가
//     이 프로그램과 무관한 용도로 함부로 쓰이는 것을 막는다.
//  2) 그 안에서는 "학교 코드를 아는 사람만 그 학교 데이터를 읽고 쓸 수 있다"는, 원래
//     Claude 아티팩트 버전과 동일한 신뢰 모델을 그대로 유지한다(=코드 자체가 비밀번호
//     역할을 겸함). 학생 실명은애초에 이 데이터베이스에 저장되지 않는다(App.jsx의
//     익명화 로직 참고).
//
// 더 강한 보안(예: 학교별로 진짜 로그인 계정을 두고 완전히 분리하는 방식)을 원하면
// Firebase Authentication을 도입하고 이 규칙을 그에 맞게 다시 작성해야 한다. 학교
// 정식 도입 전에는 학교·교육청 개인정보 담당자와 한 번 확인해 보는 것을 권장한다
// (준비 브리핑 문서 6번·8번 항목 참고).
service cloud.firestore {
  match /databases/{database}/documents {
    match /kv/{docId} {
      allow read, write: if docId.matches('paps:.*') && docId.size() < 300;
    }
    // 그 밖의 모든 경로는 기본적으로 차단한다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
